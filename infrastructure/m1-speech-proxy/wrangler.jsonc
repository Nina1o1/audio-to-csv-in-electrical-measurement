{
  "name": "m1-speech-proxy",
  "main": "worker.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "vars": { "APP_ORIGIN": "https://replace-with-your-app.example" },
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CONNECT_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "TOTAL_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ]
}
