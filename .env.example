# Clone users should not need this file once the maintainer publishes the public endpoint.
# Public HTTPS/WSS origin is pending; current server is reachable only through SSH.
# Maintainer overrides (optional; never put vendor credentials in VITE_*):
# M1_DEV_PROXY_TARGET=https://voice.your-domain.com
# M1_DEV_PROXY_ORIGIN=https://voice.your-domain.com

# Optional trusted localhost HTTPS (default localhost HTTP needs no certificate):
# M1_DEV_TLS_KEY=.certs/localhost-key.pem
# M1_DEV_TLS_CERT=.certs/localhost.pem

# Maintainer-only SSH testing; never expose the Node port to the public internet:
# M1_DEV_PROXY_TARGET=http://127.0.0.1:18787
# M1_DEV_PROXY_ORIGIN=https://localhost:5173
# M1_DEV_SSH_HOST=admin@your-server-ip
# M1_DEV_SSH_IDENTITY=/absolute/path/to/your/dedicated/ssh-key
# M1_DEV_SSH_KNOWN_HOSTS=.certs/aliyun-known-hosts
# Pin and verify the server fingerprint before creating this known-hosts file.
